# NOTE: data/trading.db IS committed on purpose - it is the paper-trading
# state that must survive across separate GitHub Actions runs. Only files
# that must stay local-only are ignored below (logs, sqlite sidecars).
data/logs/
*.db-journal
*.db-wal
*.db-shm
logs/
backtest_*/

# secrets - NEVER commit these
.env
*.key
*.pem

# python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
