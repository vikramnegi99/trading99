# =========================================================================
# AI-Powered Paper Trading Agent - configuration example
# Copy to .env and adjust. NEVER put real exchange keys or wallet seeds here.
# This project is PAPER TRADING ONLY - no real-money execution exists.
# =========================================================================

# --- Trading -------------------------------------------------------------
STARTING_BALANCE=100
SCAN_INTERVAL_MINUTES=10
MIN_EDGE=0.08
MIN_CONFIDENCE=0.60
MAX_SPREAD=0.05
MIN_LIQUIDITY=1000
MIN_VOLUME=5000
MIN_DAYS_TO_RESOLUTION=1
MAX_DAYS_TO_RESOLUTION=180
MAX_AI_CALLS_PER_CYCLE=25

# --- Risk ------------------------------------------------------------------
MAX_POSITION_PERCENT=0.06
MAX_OPEN_EXPOSURE_PERCENT=0.25
MAX_DAILY_LOSS_PERCENT=0.10
MAX_DRAWDOWN_PERCENT=0.30
MAX_OPEN_POSITIONS=15
KELLY_FRACTION=0.25

# --- Simulation realism ----------------------------------------------------
SIMULATED_FEES=true
FEE_PERCENT=0.002
SLIPPAGE_PERCENT=0.01
EXECUTION_DELAY_SECONDS=0
REALISTIC_EXECUTION=true

# --- Safety (do not change) ------------------------------------------------
# REAL_TRADING is permanently false. Setting it to true makes the program
# refuse to start. Kill switch stops all new trades when true.
REAL_TRADING=false
KILL_SWITCH=false

# --- Runtime ---------------------------------------------------------------
DATA_SOURCE=polymarket          # polymarket | mock
DATABASE_PATH=data/trading.db
LOG_DIR=data/logs
DASHBOARD_PATH=dashboard.html
CACHE_TTL_SECONDS=300

# --- Optional AI provider ---------------------------------------------------
# Default AI_PROVIDER=heuristic works offline for free. To use an LLM with
# any OpenAI-compatible endpoint, set AI_PROVIDER=openai + the key as a
# GitHub Actions secret named OPENAI_API_KEY (never commit the key itself).
AI_PROVIDER=heuristic
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
